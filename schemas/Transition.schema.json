{
  "$defs": {
    "CandidateAction": {
      "additionalProperties": false,
      "properties": {
        "arguments": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Arguments",
          "type": "object"
        },
        "id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "move",
            "wait",
            "answer",
            "interact",
            "ability",
            "inventory",
            "info"
          ],
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "label"
      ],
      "title": "CandidateAction",
      "type": "object"
    },
    "JsonValue": {},
    "Metrics": {
      "additionalProperties": false,
      "properties": {
        "decisions_elapsed": {
          "minimum": 0,
          "title": "Decisions Elapsed",
          "type": "integer"
        },
        "objective_version": {
          "title": "Objective Version",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "ongoing",
            "success",
            "death",
            "time_limit"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "task_id": {
          "title": "Task Id",
          "type": "string"
        },
        "turns_elapsed": {
          "minimum": 0,
          "title": "Turns Elapsed",
          "type": "integer"
        }
      },
      "required": [
        "task_id",
        "objective_version",
        "outcome",
        "turns_elapsed",
        "decisions_elapsed"
      ],
      "title": "Metrics",
      "type": "object"
    },
    "Observation": {
      "additionalProperties": false,
      "properties": {
        "actions": {
          "items": {
            "$ref": "#/$defs/CandidateAction"
          },
          "title": "Actions",
          "type": "array"
        },
        "decision_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Decision Id",
          "type": "string"
        },
        "entities": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PerceivedEntity"
          },
          "title": "Entities",
          "type": "array"
        },
        "episode_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Episode Id",
          "type": "string"
        },
        "messages": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Messages",
          "type": "array"
        },
        "phase": {
          "enum": [
            "command",
            "prompt",
            "terminal"
          ],
          "title": "Phase",
          "type": "string"
        },
        "player": {
          "$ref": "#/$defs/Player"
        },
        "prompt": {
          "anyOf": [
            {
              "$ref": "#/$defs/Prompt"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "quests": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Quests",
          "type": "array"
        },
        "tiles": {
          "items": {
            "type": "string"
          },
          "title": "Tiles",
          "type": "array"
        },
        "turn": {
          "minimum": 0,
          "title": "Turn",
          "type": "integer"
        },
        "view": {
          "anyOf": [
            {
              "$ref": "#/$defs/ViewInfo"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "episode_id",
        "decision_id",
        "turn",
        "phase",
        "player",
        "tiles",
        "actions"
      ],
      "title": "Observation",
      "type": "object"
    },
    "PerceivedEntity": {
      "additionalProperties": false,
      "properties": {
        "glyph": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Glyph"
        },
        "id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "is_actor": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Is Actor"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "perceived_status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Perceived Status"
        },
        "x": {
          "title": "X",
          "type": "integer"
        },
        "y": {
          "title": "Y",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "name",
        "x",
        "y"
      ],
      "title": "PerceivedEntity",
      "type": "object"
    },
    "Player": {
      "additionalProperties": false,
      "properties": {
        "hp": {
          "minimum": 0,
          "title": "Hp",
          "type": "integer"
        },
        "max_hp": {
          "exclusiveMinimum": 0,
          "title": "Max Hp",
          "type": "integer"
        },
        "x": {
          "title": "X",
          "type": "integer"
        },
        "y": {
          "title": "Y",
          "type": "integer"
        }
      },
      "required": [
        "x",
        "y",
        "hp",
        "max_hp"
      ],
      "title": "Player",
      "type": "object"
    },
    "Prompt": {
      "additionalProperties": false,
      "properties": {
        "allow_cancel": {
          "default": false,
          "title": "Allow Cancel",
          "type": "boolean"
        },
        "kind": {
          "enum": [
            "choice",
            "direction",
            "target",
            "text"
          ],
          "title": "Kind",
          "type": "string"
        },
        "options": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Options",
          "type": "array"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "text"
      ],
      "title": "Prompt",
      "type": "object"
    },
    "ViewInfo": {
      "additionalProperties": false,
      "description": "How much of the world the observation actually covers.\n\nA radius tells the agent the edge of what it can see, so a missing\nneighbour is not mistaken for the edge of the map.",
      "properties": {
        "radius": {
          "minimum": 0,
          "title": "Radius",
          "type": "integer"
        },
        "zone_height": {
          "minimum": 0,
          "title": "Zone Height",
          "type": "integer"
        },
        "zone_width": {
          "minimum": 0,
          "title": "Zone Width",
          "type": "integer"
        }
      },
      "required": [
        "radius",
        "zone_width",
        "zone_height"
      ],
      "title": "ViewInfo",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "metrics": {
      "$ref": "#/$defs/Metrics"
    },
    "observation": {
      "$ref": "#/$defs/Observation"
    },
    "reward": {
      "title": "Reward",
      "type": "number"
    },
    "terminated": {
      "title": "Terminated",
      "type": "boolean"
    },
    "truncated": {
      "title": "Truncated",
      "type": "boolean"
    }
  },
  "required": [
    "observation",
    "reward",
    "terminated",
    "truncated",
    "metrics"
  ],
  "title": "Transition",
  "type": "object"
}
