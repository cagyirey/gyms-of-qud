{
  "$defs": {
    "CandidateAction": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "move",
            "wait",
            "answer",
            "interact",
            "ability",
            "inventory",
            "info"
          ],
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "arguments": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Arguments",
          "type": "object"
        }
      },
      "required": [
        "id",
        "kind",
        "label"
      ],
      "title": "CandidateAction",
      "type": "object"
    },
    "JsonValue": {},
    "PerceivedEntity": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "x": {
          "title": "X",
          "type": "integer"
        },
        "y": {
          "title": "Y",
          "type": "integer"
        },
        "perceived_status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Perceived Status"
        },
        "glyph": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Glyph"
        },
        "is_actor": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Is Actor"
        }
      },
      "required": [
        "id",
        "name",
        "x",
        "y"
      ],
      "title": "PerceivedEntity",
      "type": "object"
    },
    "Player": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "title": "X",
          "type": "integer"
        },
        "y": {
          "title": "Y",
          "type": "integer"
        },
        "hp": {
          "minimum": 0,
          "title": "Hp",
          "type": "integer"
        },
        "max_hp": {
          "exclusiveMinimum": 0,
          "title": "Max Hp",
          "type": "integer"
        }
      },
      "required": [
        "x",
        "y",
        "hp",
        "max_hp"
      ],
      "title": "Player",
      "type": "object"
    },
    "Prompt": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "choice",
            "direction",
            "target",
            "text"
          ],
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "options": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Options",
          "type": "array"
        },
        "unavailable": {
          "default": [],
          "items": {
            "type": "integer"
          },
          "title": "Unavailable",
          "type": "array"
        },
        "allow_cancel": {
          "default": false,
          "title": "Allow Cancel",
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "text"
      ],
      "title": "Prompt",
      "type": "object"
    },
    "ViewInfo": {
      "additionalProperties": false,
      "description": "How much of the world the observation actually covers.\n\nA radius tells the agent the edge of what it can see, so a missing\nneighbour is not mistaken for the edge of the map.",
      "properties": {
        "radius": {
          "minimum": 0,
          "title": "Radius",
          "type": "integer"
        },
        "zone_width": {
          "minimum": 0,
          "title": "Zone Width",
          "type": "integer"
        },
        "zone_height": {
          "minimum": 0,
          "title": "Zone Height",
          "type": "integer"
        }
      },
      "required": [
        "radius",
        "zone_width",
        "zone_height"
      ],
      "title": "ViewInfo",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "episode_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Episode Id",
      "type": "string"
    },
    "decision_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Decision Id",
      "type": "string"
    },
    "turn": {
      "minimum": 0,
      "title": "Turn",
      "type": "integer"
    },
    "phase": {
      "enum": [
        "command",
        "prompt",
        "terminal"
      ],
      "title": "Phase",
      "type": "string"
    },
    "player": {
      "$ref": "#/$defs/Player"
    },
    "tiles": {
      "items": {
        "type": "string"
      },
      "title": "Tiles",
      "type": "array"
    },
    "entities": {
      "default": [],
      "items": {
        "$ref": "#/$defs/PerceivedEntity"
      },
      "title": "Entities",
      "type": "array"
    },
    "messages": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Messages",
      "type": "array"
    },
    "prompt": {
      "anyOf": [
        {
          "$ref": "#/$defs/Prompt"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "quests": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Quests",
      "type": "array"
    },
    "actions": {
      "items": {
        "$ref": "#/$defs/CandidateAction"
      },
      "title": "Actions",
      "type": "array"
    },
    "view": {
      "anyOf": [
        {
          "$ref": "#/$defs/ViewInfo"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "episode_id",
    "decision_id",
    "turn",
    "phase",
    "player",
    "tiles",
    "actions"
  ],
  "title": "Observation",
  "type": "object"
}
