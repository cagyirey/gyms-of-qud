<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <QudManaged Condition="'$(QudManaged)' == ''">$(HOME)/Library/Application Support/Steam/steamapps/common/Caves of Qud/CoQ.app/Contents/Resources/Data/Managed</QudManaged>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>$(MSBuildThisFileDirectory)../QudGym/lib/</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Suave" Version="2.6.2" />
  </ItemGroup>
  <ItemGroup>
    <!-- The game already loads Newtonsoft.Json, so borrowing it costs nothing
         at runtime and removes the hand-rolled request parsing. -->
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(QudManaged)/Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Probe.fs" />
    <Compile Include="Embark.fs" />
    <Compile Include="Plan.fs" />
    <Compile Include="Session.fs" />
    <!-- Every library preset is embedded, so a boot can select one by id. -->
    <EmbeddedResource Include="../../loadouts/*.json">
      <LogicalName>loadouts/%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <!-- Generated by `qudgym eye-preset-index`: id, sha256, path, location. -->
    <EmbeddedResource Include="presets.index">
      <LogicalName>presets.index</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
